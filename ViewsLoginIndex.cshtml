@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>TARGET Giriş</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light d-flex align-items-center" style="height:100vh;">
    <div class="container text-center">
        <h2 class="mb-4">TARGET Envanter Sistemi</h2>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <form method="post" class="w-25 mx-auto">
            <input name="Eposta" class="form-control mb-3" placeholder="E-posta" required />
            <input name="Sifre" type="password" class="form-control mb-3" placeholder="Şifre" required />
            <button class="btn btn-primary w-100">Giriş Yap</button>
        </form>
    </div>
</body>
</html>
